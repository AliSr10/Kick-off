+/* =========================================================
+   ANIMATED MATCH PASS
+   ========================================================= */
+
+animatedPassBtn.addEventListener(
+  'click',
+  async () => {
+
+    if (
+      !window.MediaRecorder ||
+      !HTMLCanvasElement.prototype.captureStream
+    ) {
+
+      alert(
+        'Animated Pass recording is not supported by this browser. You can still save the normal Match Pass.'
+      );
+
+      return;
+
+    }
+
+
+    const original =
+      animatedPassBtn.innerHTML;
+
+    animatedPassBtn.disabled =
+      true;
+
+    animatedPassBtn.textContent =
+      'CREATING VIDEO...';
+
+
+    try {
+
+      /*
+       Render the portrait ticket ONCE.
+
+       The animation then happens on canvas,
+       which is much faster than repeatedly
+       screenshotting the webpage.
+      */
+
+      const baseCanvas =
+        await renderPortraitTicket();
+
+
+      const videoCanvas =
+        document.createElement('canvas');
+
+      videoCanvas.width =
+        1080;
+
+      videoCanvas.height =
+        1920;
+
+
+      const ctx =
+        videoCanvas.getContext('2d');
+
+
+      const FPS =
+        24;
+
+      const DURATION =
+        5000;
+
+
+      const stream =
+        videoCanvas.captureStream(FPS);
+
+
+      const supportedTypes = [
+
+        'video/mp4;codecs=avc1.42E01E',
+
+        'video/mp4',
+
+        'video/webm;codecs=vp9',
+
+        'video/webm;codecs=vp8',
+
+        'video/webm'
+
+      ];
+
+
+      const mimeType =
+        supportedTypes.find(type =>
+          MediaRecorder.isTypeSupported(type)
+        );
+
+
+      if (!mimeType) {
+
+        throw new Error(
+          'No supported video recording format.'
+        );
+
+      }
+
+
+      const extension =
+        mimeType.includes('mp4')
+          ? 'mp4'
+          : 'webm';
+
+
+      const recorder =
+        new MediaRecorder(
+          stream,
+          {
+
+            mimeType,
+
+            videoBitsPerSecond:
+              8000000
+
+          }
+        );
+
+
+      const chunks =
+        [];
+
+
+      recorder.ondataavailable =
+        event => {
+
+          if (event.data.size > 0) {
+
+            chunks.push(
+              event.data
+            );
+
+          }
+
+        };
+
+
+      const finishedRecording =
+        new Promise(
+          (resolve, reject) => {
+
+            recorder.onstop =
+              () => {
+
+                resolve(
+
+                  new Blob(
+                    chunks,
+                    {
+                      type:
+                        mimeType
+                    }
+                  )
+
+                );
+
+              };
+
+
+            recorder.onerror =
+              reject;
+
+          }
+        );
+
+
+      /* -------------------------------
+         Animated particle configuration
+         ------------------------------- */
+
+      const particles =
+        Array.from(
+          { length: 45 },
+          () => ({
+
+            x:
+              Math.random() *
+              1080,
+
+            y:
+              Math.random() *
+              1920,
+
+            radius:
+              Math.random() * 3 + 1,
+
+            speed:
+              Math.random() * 14 + 8,
+
+            alpha:
+              Math.random() * 0.35 + 0.1
+
+          })
+        );
+
+
+      recorder.start();
+
+
+      const start =
+        performance.now();
+
+
+      function drawFrame(now) {
+
+        const elapsed =
+          now - start;
+
+
+        const progress =
+          Math.min(
+            elapsed / DURATION,
+            1
+          );
+
+
+        const seconds =
+          elapsed / 1000;
+
+
+        ctx.clearRect(
+          0,
+          0,
+          1080,
+          1920
+        );
+
+
+        /* Slow cinematic push */
+
+        const zoom =
+          1 +
+          Math.sin(
+            progress *
+            Math.PI
+          ) *
+          0.018;
+
+
+        ctx.save();
+
+
+        ctx.translate(
+          540,
+          960
+        );
+
+
+        ctx.scale(
+          zoom,
+          zoom
+        );
+
+
+        ctx.drawImage(
+          baseCanvas,
+          -540,
+          -960,
+          1080,
+          1920
+        );
+
+
+        ctx.restore();
+
+
+        /* Animated green ambient glow */
+
+        const glow =
+          ctx.createRadialGradient(
+            540,
+            650,
+            30,
+            540,
+            650,
+            650
+          );
+
+
+        const glowPulse =
+          0.06 +
+          Math.sin(
+            seconds * 2
+          ) * 0.018;
+
+
+        glow.addColorStop(
+          0,
+          `rgba(0,255,102,${glowPulse})`
+        );
+
+
+        glow.addColorStop(
+          1,
+          'rgba(0,255,102,0)'
+        );
+
+
+        ctx.fillStyle =
+          glow;
+
+
+        ctx.fillRect(
+          0,
+          0,
+          1080,
+          1920
+        );
+
+
+        /* Floating stadium particles */
+
+        particles.forEach(
+          particle => {
+
+            particle.y -=
+              particle.speed / FPS;
+
+
+            if (
+              particle.y < -10
+            ) {
+
+              particle.y =
+                1930;
+
+              particle.x =
+                Math.random() *
+                1080;
+
+            }
+
+
+            ctx.beginPath();
+
+
+            ctx.arc(
+              particle.x,
+              particle.y,
+              particle.radius,
+              0,
+              Math.PI * 2
+            );
+
+
+            ctx.fillStyle =
+              `rgba(0,255,102,${particle.alpha})`;
+
+
+            ctx.fill();
+
+          }
+        );
+
+
+        /* Cinematic scanning laser */
+
+        const scanCycle =
+          (seconds % 2.5) /
+          2.5;
+
+
+        const laserY =
+          scanCycle *
+          1920;
+
+
+        const laser =
+          ctx.createLinearGradient(
+            0,
+            laserY - 100,
+            0,
+            laserY + 100
+          );
+
+
+        laser.addColorStop(
+          0,
+          'rgba(0,255,102,0)'
+        );
+
+
+        laser.addColorStop(
+          0.5,
+          'rgba(0,255,102,0.45)'
+        );
+
+
+        laser.addColorStop(
+          1,
+          'rgba(0,255,102,0)'
+        );
+
+
+        ctx.fillStyle =
+          laser;
+
+
+        ctx.fillRect(
+          0,
+          laserY - 100,
+          1080,
+          200
+        );
+
+
+        ctx.fillStyle =
+          'rgba(0,255,102,0.9)';
+
+
+        ctx.fillRect(
+          0,
+          laserY,
+          1080,
+          3
+        );
+
+
+        if (
+          elapsed <
+          DURATION
+        ) {
+
+          requestAnimationFrame(
+            drawFrame
+          );
+
+        }
+
+        else {
+
+          recorder.stop();
+
+        }
+
+      }
+
+
+      requestAnimationFrame(
+        drawFrame
+      );
+
+
+      const videoBlob =
+        await finishedRecording;
+
+
+      downloadBlob(
+        videoBlob,
+        `${ticketData.id}-ANIMATED-PASS.${extension}`
+      );
+
+
+    } catch (error) {
+
+      console.error(error);
+
+      alert(
+        'Animated Pass could not be created on this browser.'
+      );
+
+    } finally {
+
+      animatedPassBtn.disabled =
+        false;
+
+      animatedPassBtn.innerHTML =
+        original;
+
+    }
+
