+/* Layout refinements layered over the original Kickoff styles and animations. */
+[hidden] { display: none !important; }
+html { -webkit-text-size-adjust: 100%; scroll-padding-top: 124px; }
+button, input, select, textarea { font: inherit; }
+button, a, input, select { -webkit-tap-highlight-color: transparent; }
+button, a { touch-action: manipulation; }
+:is(button, a, input, select, [tabindex]):focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
+:is(.btn, .btn-text, .icon-btn, .auth-btn, .close-btn, .nav-tab, .pass-action) { min-height: 44px; }
+.btn:disabled, .auth-btn:disabled, .neon-submit:disabled { cursor: wait; opacity: .65; }
+.site-back { color: var(--accent); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; font: 600 1rem 'Rajdhani', sans-serif; }
+body.is-dialog-open { overflow: hidden; }
+
+/* Public navigation and customer sign-in. */
+.public-page { min-height: 100svh; }
+.topbar { gap: 12px; padding-left: max(16px, env(safe-area-inset-left)); padding-right: max(16px, env(safe-area-inset-right)); }
+.topbar-brand { min-width: 0; gap: 8px; }
+.topbar-brand .icon-btn { width: 44px; flex-shrink: 0; }
+.topbar-actions { display: flex; align-items: center; gap: 16px; min-width: 0; }
+.topbar-actions .header-auth { margin-right: 0 !important; padding: 8px 12px; color: var(--accent); border: 1px solid var(--surface-border); border-radius: 8px; font-family: var(--font-display); font-size: 1rem !important; font-weight: 700; max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.desktop-nav a { padding-inline: 12px; }
+.sidebar { width: min(340px, calc(100% - 24px)); height: 100dvh; padding: max(24px, env(safe-area-inset-top)) 20px max(24px, env(safe-area-inset-bottom)); visibility: hidden; transition: left .4s cubic-bezier(.16, 1, .3, 1), visibility 0s .4s; }
+.sidebar.active { visibility: visible; transition-delay: 0s, 0s; }
+.sidebar-links { gap: 8px; overflow-y: auto; overscroll-behavior: contain; }
+.sidebar-links .nav-item { display: flex; align-items: center; min-height: 48px; font-size: 1.45rem; padding-block: 6px; min-width: 0; overflow-wrap: anywhere; }
+.sidebar-header { margin-bottom: 20px; }
+.progress-container { padding-inline: 16px; gap: 10px; background: linear-gradient(var(--bg-color), rgba(5, 7, 8, .95)); }
+.step { font-size: .8rem; white-space: nowrap; padding-block: 4px 10px; }
+.entry-shell { display: grid; place-items: center; min-height: min(650px, calc(100svh - 160px)); padding-block: 16px; }
+.public-auth-card { max-width: 440px; padding: 36px 32px; }
+.auth-title { font: 700 1.85rem var(--font-display); margin-top: 16px; letter-spacing: .2px; }
+.auth-intro { color: #a0ada5; font-size: .95rem; line-height: 1.6; margin: 10px 0 26px; }
+.auth-actions { display: flex; flex-direction: column; gap: 12px; }
+.auth-btn { min-height: 56px; font-size: 1.05rem; letter-spacing: .5px; padding: 14px 16px; text-transform: none; }
+.auth-btn svg { flex-shrink: 0; }
+.auth-hint, .staff-entry p, .staff-login-help { color: #a0ada5; font-size: .82rem; line-height: 1.5; }
+.auth-hint { margin-top: 14px; }
+.staff-entry { border-top: 1px solid var(--surface-border); margin-top: 26px; padding-top: 18px; }
+.staff-entry-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--accent); font-size: .95rem; text-decoration: none; font-weight: 600; }
+.auth-error { border: 1px solid rgba(255, 51, 102, .4); background: rgba(255, 51, 102, .07); padding: 12px; border-radius: 8px; color: #ff9db7; font-size: .9rem; line-height: 1.5; margin-bottom: 18px; }
+.view-header, .minimal-form, .digital-ticket, .location-details-card, .feature-card, .rule-card { min-width: 0; }
+.view-title { font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3rem); line-height: 1.15; overflow-wrap: anywhere; }
+.selected-context { color: var(--text-dim); line-height: 1.6; margin-top: 10px; overflow-wrap: anywhere; }
+.field-hint { color: var(--text-dim); font-size: .82rem; line-height: 1.5; margin-top: 8px; }
+.date-node, .time-node { font: inherit; color: inherit; appearance: none; text-align: left; width: 100%; }
+.date-node { min-height: 92px; }
+.time-node { gap: 12px; min-height: 72px; }
+.time-node.selected { border-color: var(--accent); background: var(--accent-dim); }
+.time-node.booked { opacity: .55; }
+.time-status { text-align: right; }
+.background-watermark { font-size: clamp(7rem, 24vw, 18rem); left: 0; max-width: 100%; }
+.digital-ticket { width: 100%; }
+.ticket-header, .ticket-row { gap: 16px; }
+.ticket-col { min-width: 0; }
+.ticket-status, .ticket-id, .t-value { overflow-wrap: anywhere; }
+.confirm-modal-overlay, .modal-overlay { padding: max(16px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right)) max(16px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left)); overflow-y: auto; overscroll-behavior: contain; visibility: hidden; transition: opacity .3s ease, visibility 0s .3s; }
+.confirm-modal-overlay.active, .modal-overlay.active { visibility: visible; transition-delay: 0s, 0s; }
+.confirm-modal, .modal-card { width: 100%; min-width: 0; max-height: calc(100dvh - 32px - env(safe-area-inset-top) - env(safe-area-inset-bottom)); overflow-y: auto; overscroll-behavior: contain; }
+.confirm-actions { display: flex; gap: 12px; }
+.modern-footer { padding-bottom: max(24px, env(safe-area-inset-bottom)); }
+.footer-links a { display: inline-flex; align-items: center; min-height: 44px; }
+
+/* Staff sign-in retains the original neon button and animated border. */
+.admin-page { --surface: var(--bg-surface); --surface-border: rgba(255, 255, 255, .1); --text-dim: var(--text-muted); --accent-dim: var(--accent-glow); }
+.auth-body { height: auto; min-height: 100svh; padding: max(20px, env(safe-area-inset-top)) max(20px, env(safe-area-inset-right)) max(32px, env(safe-area-inset-bottom)) max(20px, env(safe-area-inset-left)); display: flex; flex-direction: column; align-items: stretch; gap: 20px; }
+.auth-body > .site-back { align-self: flex-start; }
+.staff-login { position: relative; top: auto; left: auto; transform: none; width: 100%; margin: auto; max-width: 430px; padding: 36px; }
+.staff-login h2 { font-size: 1.8rem; letter-spacing: 2px !important; margin-bottom: 0; }
+.staff-login .auth-intro { text-align: center; margin-bottom: 28px; }
+.staff-login .user-box { margin-bottom: 24px; }
+.staff-login .user-box label { position: static; display: block; padding: 0; margin-bottom: 8px; font-size: .9rem; color: var(--text-muted); }
+.staff-login .user-box input { display: block; font-size: 16px; line-height: 1.5; min-height: 48px; border-bottom-color: var(--text-muted); margin: 0; padding: 12px 0; border-radius: 0; }
+.staff-login #password { padding-right: 68px; }
+.password-toggle { position: absolute; right: 0; bottom: 2px; min-width: 60px; min-height: 44px; padding: 8px; border: 0; border-radius: 6px; background: transparent; color: var(--accent); font: 600 .85rem var(--font-body); cursor: pointer; }
+.neon-submit { min-height: 52px; letter-spacing: 2px; }
+.neon-submit b { font: inherit; }
+.staff-login-help { text-align: center; margin: 24px 0 10px; }
+.customer-login-link { display: flex; align-items: center; justify-content: center; min-height: 44px; color: var(--accent); text-align: center; font-size: .9rem; text-decoration: none; line-height: 1.5; }
+
+/* Staff workspace: shrinkable columns, reachable dialogs and readable mobile cards. */
+.admin-topbar .topbar-left, .admin-topbar .topbar-right { display: flex; align-items: center; gap: 12px; min-width: 0; }
+.admin-topbar .operator-badge { margin-right: 0; overflow-wrap: anywhere; }
+.dashboard-sidebar { flex-shrink: 0; }
+.dashboard-main, .content-view, .chart-card, .stats-grid > *, .form-group { min-width: 0; }
+.dashboard-main { overflow: visible; }
+.dashboard-page .stats-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.stat-label { line-height: 1.5; overflow-wrap: anywhere; }
+.chart-heading { flex-wrap: wrap; gap: 8px; }
+.chart-heading > * { min-width: 0; }
+.view-controls { gap: 16px; flex-wrap: wrap; }
+.date-picker-wrap { min-width: 0; }
+.date-picker-wrap > label { display: block; color: var(--text-muted); font-size: .85rem; margin-bottom: 8px; }
+.legend { display: flex; flex-wrap: wrap; gap: 12px; color: var(--text-muted); font-size: .85rem; }
+.legend-item { display: inline-flex; align-items: center; gap: 6px; }
+.dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; }
+.dot-avail { background: var(--accent); } .dot-booked { background: var(--warning); }
+.booking-toolbar { gap: 16px; flex-wrap: wrap; }
+.toolbar-actions { flex-wrap: wrap; }
+.table-card { overflow-x: auto; overscroll-behavior-x: contain; }
+.admin-table { min-width: 760px; }
+.admin-table td { overflow-wrap: anywhere; }
+.table-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: flex-end; }
+.timeline-row { gap: 16px; }
+.timeline-time { flex-shrink: 0; }
+.timeline-meta { min-width: 0; overflow-wrap: anywhere; }
+.form-row > * { min-width: 0; }
+.modal-header { gap: 12px; }
+.modal-header h3 { font: 700 1.3rem var(--font-display); min-width: 0; overflow-wrap: anywhere; }
+.close-btn { width: 44px; flex-shrink: 0; }
+.admin-input { min-height: 48px; font-size: 16px; }
+.viewport-calendar::before, .viewport-calendar::after { display: none; }
+
+/* Match pass: normal page flow keeps the pass and all three export actions reachable. */
+.ticket-page { height: auto; min-height: 100svh; width: 100%; overflow-x: clip; overflow-y: auto; display: flex; flex-direction: column; perspective: none; background-color: var(--bg-core); }
+.ticket-page .stadium-viewport { position: fixed; inset: 0; overflow: hidden; pointer-events: none; z-index: 1; }
+.ticket-page .stadium-env { position: absolute; }
+.ticket-page #ambientCanvas { position: fixed; pointer-events: none; }
+.ticket-page #ticketExport { display: none; }
+.ticket-page .pass-stage { order: 1; width: 100%; perspective: 1200px; overflow: clip; flex-shrink: 0; }
+.ticket-page .ticket-back { order: 0; z-index: 20; align-self: flex-start; margin: max(12px, env(safe-area-inset-top)) 20px 0; }
+.ticket-page .spatial-pass-wrapper { order: 1; height: auto; min-height: max(480px, calc(100svh - 210px)); width: 100%; padding: 32px 20px 40px; }
+.ticket-page .pass-content { min-width: 0; gap: 24px; padding-inline: 12px; }
+.ticket-page .player-group, .ticket-page .match-core, .ticket-page .venue-info { max-width: 100%; min-width: 0; }
+.ticket-page .player-name, .ticket-page .match-time, .ticket-page .pass-id { overflow-wrap: anywhere; max-width: 100%; }
+.ticket-page .verified-status { max-width: 100%; text-align: center; font-size: clamp(.75rem, 2.5vw, 1rem); padding: 10px 18px; }
+.ticket-page .verified-status .dot { flex-shrink: 0; }
+.ticket-page .pass-actions { order: 2; position: relative; left: auto; bottom: auto; transform: none; width: min(calc(100% - 32px), 430px); margin: 0 auto max(20px, env(safe-area-inset-bottom)); flex-shrink: 0; }
+.ticket-page .secondary-action { min-height: 48px; font-size: .85rem; }
+
+@media (max-width: 1100px) {
+  .desktop-nav { display: none; }
+  .topbar-brand .icon-btn { display: grid; place-items: center; }
+  .dashboard-layout { flex-direction: column; min-height: 0; }
+  .dashboard-sidebar { width: 100%; padding: 20px 24px; gap: 16px; border-right: 0; border-bottom: 1px solid var(--surface-border); }
+  .sidebar-nav { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
+  .nav-tab { min-width: 0; text-align: center; padding: 12px 8px; font-size: .9rem; line-height: 1.4; }
+  .dashboard-main { padding: 24px; }
+  .dashboard-page .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-bottom: 24px; }
+}
+@media (max-width: 700px) {
+  .public-page { background-attachment: scroll; }
+  .topbar { height: calc(68px + env(safe-area-inset-top)); padding-top: env(safe-area-inset-top); }
+  .topbar .logo-text { font-size: 1.4rem; letter-spacing: 1px; }
+  .topbar-actions { gap: 8px; }
