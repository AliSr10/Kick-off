+  const mainGlow = ctx.createRadialGradient(
+    W / 2,
+    250,
+    20,
+    W / 2,
+    500,
+    900
+  );
+
+  mainGlow.addColorStop(
+    0,
+    'rgba(105, 155, 128, 0.65)'
+  );
+
+  mainGlow.addColorStop(
+    0.35,
+    'rgba(26, 55, 41, 0.45)'
+  );
+
+  mainGlow.addColorStop(
+    1,
+    'rgba(5, 8, 7, 0)'
+  );
+
+  ctx.fillStyle = mainGlow;
+
+  ctx.fillRect(
+    0,
+    0,
+    W,
+    H
+  );
+
+
+  // =====================================================
+  // LIGHT BEAMS
+  // =====================================================
+
+  ctx.save();
+
+  ctx.globalAlpha = 0.1;
+
+  const leftBeam = ctx.createLinearGradient(
+    100,
+    0,
+    500,
+    1300
+  );
+
+  leftBeam.addColorStop(
+    0,
+    'rgba(0,255,102,0.7)'
+  );
+
+  leftBeam.addColorStop(
+    1,
+    'rgba(0,255,102,0)'
+  );
+
+  ctx.fillStyle = leftBeam;
+
+  ctx.beginPath();
+
+  ctx.moveTo(
+    120,
+    0
+  );
+
+  ctx.lineTo(
+    370,
+    0
+  );
+
+  ctx.lineTo(
+    700,
+    1550
+  );
+
+  ctx.lineTo(
+    430,
+    1550
+  );
+
+  ctx.closePath();
+
+  ctx.fill();
+
+
+  ctx.restore();
+
+
+  // =====================================================
+  // AMBIENT PARTICLES
+  // =====================================================
+
+  for (let i = 0; i < 55; i++) {
+
+    const x =
+      Math.random() * W;
+
+    const y =
+      Math.random() * H;
+
+    const r =
+      Math.random() * 2.5 + 0.7;
+
+    const opacity =
+      Math.random() * 0.28 + 0.06;
+
+    ctx.beginPath();
+
+    ctx.arc(
+      x,
+      y,
+      r,
+      0,
+      Math.PI * 2
+    );
+
+    ctx.fillStyle =
+      `rgba(0,255,102,${opacity})`;
+
+    ctx.fill();
+
+  }
+
+
+  // =====================================================
+  // HELPERS
+  // =====================================================
+
+  function centerText(
+    text,
+    y,
+    font,
+    color = '#FFFFFF',
+    letterSpacing = 0
+  ) {
+
+    ctx.font = font;
+
+    ctx.fillStyle =
+      color;
+
+    ctx.textAlign =
+      'center';
+
+    ctx.textBaseline =
+      'middle';
+
+
+    if (!letterSpacing) {
+
+      ctx.fillText(
+        text,
+        W / 2,
+        y
+      );
+
+      return;
+
+    }
+
+
+    const chars =
+      [...text];
+
+
+    const widths =
+      chars.map(
+        char =>
+          ctx.measureText(char).width
+      );
+
+
+    const total =
+      widths.reduce(
+        (a, b) => a + b,
+        0
+      ) +
+      letterSpacing *
+      (chars.length - 1);
+
+
+    let x =
+      W / 2 -
+      total / 2;
+
+
+    chars.forEach(
+      (char, index) => {
+
+        ctx.fillText(
+          char,
+          x +
+          widths[index] / 2,
+          y
+        );
+
+        x +=
+          widths[index] +
+          letterSpacing;
+
+      }
+    );
+
+  }
+
+
+  // =====================================================
+  // BRAND
+  // =====================================================
+
+  centerText(
+    'KICKOFF OS',
+    165,
+    '800 22px Inter',
+    '#829089',
+    7
+  );
+
+
+  centerText(
+    'MATCH PASS',
+    225,
+    '800 62px Rajdhani',
+    '#FFFFFF',
+    8
+  );
+
+
+  // Small accent line
+
+  const topLine =
+    ctx.createLinearGradient(
+      390,
+      0,
+      690,
+      0
+    );
+
+  topLine.addColorStop(
+    0,
+    'rgba(0,255,102,0)'
+  );
+
+  topLine.addColorStop(
+    0.5,
+    'rgba(0,255,102,0.8)'
+  );
+
+  topLine.addColorStop(
+    1,
+    'rgba(0,255,102,0)'
+  );
+
+
+  ctx.fillStyle =
+    topLine;
+
+  ctx.fillRect(
+    390,
+    280,
+    300,
+    2
+  );
+
+
+  // =====================================================
+  // TICKET ID
+  // =====================================================
+
+  ctx.shadowColor =
+    'rgba(0,255,102,0.5)';
+
+  ctx.shadowBlur =
+    22;
+
+
+  centerText(
+    ticketData.id,
+    370,
+    '700 34px "Space Mono"',
+    '#00FF66'
+  );
+
+
+  ctx.shadowBlur =
+    0;
+
+
+  // =====================================================
+  // PLAYER
+  // =====================================================
+
+  centerText(
+    'PLAYER',
+    525,
+    '800 20px Inter',
+    '#83918A',
+    7
+  );
+
+
+  // Preserve the original single-line style and fit longer names inside the saved pass.
+  const playerName = ticketData.name.toUpperCase();
+  function nameWidth(text) {
+    return [...text].reduce((sum, char) => sum + ctx.measureText(char).width, 0) + Math.max(0, [...text].length - 1) * 2;
+  }
+  function nameLines(size) {
+    ctx.font = `800 ${size}px Rajdhani`;
+    const lines = []; let line = '';
+    for (const word of playerName.split(/\s+/)) {
+      const candidate = line ? `${line} ${word}` : word;
+      if (nameWidth(candidate) <= 864) { line = candidate; continue; }
+      if (line) { lines.push(line); line = ''; }
+      for (const char of word) {
+        if (line && nameWidth(line + char) > 864) { lines.push(line); line = char; }
+        else line += char;
+      }
+    }
+    if (line) lines.push(line);
+    return lines;
+  }
+  ctx.font = '800 74px Rajdhani';
+  if (nameWidth(playerName) <= 864) centerText(playerName, 600, '800 74px Rajdhani', '#FFFFFF', 2);
+  else {
+    let size = 74, lines = nameLines(size);
+    while (size > 20 && (lines.length > 3 || lines.length * size + (lines.length - 1) * 4 > 136)) lines = nameLines(size -= 2);
+    lines.forEach((line, index) => centerText(line, 548 + size + index * (size + 4), `800 ${size}px Rajdhani`, '#FFFFFF', 2));
+  }
+
+
+  // =====================================================
+  // DIVIDER
+  // =====================================================
+
+  const divider =
+    ctx.createLinearGradient(
+      390,
+      0,
+      690,
+      0
+    );
+
+
+  divider.addColorStop(
+    0,
+    'rgba(0,255,102,0)'
+  );
+
+  divider.addColorStop(
+    0.5,
+    'rgba(0,255,102,0.7)'
+  );
+
+  divider.addColorStop(
+    1,
+    'rgba(0,255,102,0)'
+  );
+
+
+  ctx.fillStyle =
+    divider;
+
+
+  ctx.fillRect(
+    390,
+    700,
+    300,
+    2
+  );
+
+
+  // =====================================================
+  // KICKOFF
+  // =====================================================
+
+  centerText(
+    'KICKOFF WINDOW',
+    805,
+    '800 20px Inter',
+    '#83918A',
+    7
+  );
+
+
+  centerText(
+    ticketData.date.toUpperCase(),
+    880,
+    '700 47px Rajdhani',
+    '#FFFFFF'
+  );
+
+
+  ctx.shadowColor =
+    'rgba(0,255,102,0.40)';
+
+  ctx.shadowBlur =
+    35;
+
+
+  centerText(
+    ticketData.time.toUpperCase(),
+    990,
+    '800 79px Rajdhani',
+    '#00FF66'
+  );
+
+
+  ctx.shadowBlur =
+    0;
+
+
+  // =====================================================
+  // VENUE
+  // =====================================================
+
+  centerText(
+    'VENUE',
+    1170,
+    '800 20px Inter',
+    '#83918A',
+    7
+  );
+
+
+  centerText(
+    'CHOUEIFAT FACILITY',
+    1230,
+    '700 37px Rajdhani',
+    '#A0AAA5'
+  );
+
+
+  centerText(
+    'PITCH 1',
+    1275,
+    '700 32px Rajdhani',
+    '#77827C'
+  );
+
+
+  // =====================================================
+  // VALID RESERVATION BUTTON
+  // =====================================================
+
+  const pillWidth =
+    470;
+
+  const pillHeight =
+    86;
+
+  const pillX =
+    (W - pillWidth) / 2;
+
+  const pillY =
+    1410;
+
+
+  ctx.save();
+
+
+  ctx.shadowColor =
+    'rgba(0,255,102,0.35)';
+
+  ctx.shadowBlur =
+    35;
+
+
+  ctx.fillStyle =
+    '#00FF66';
+
+
+  ctx.beginPath();
+
+
+  ctx.roundRect(
+    pillX,
+    pillY,
+    pillWidth,
+    pillHeight,
+    pillHeight / 2
+  );
+
+
+  ctx.fill();
+
+
+  ctx.restore();
+
+
+  // Dot
+
+  ctx.beginPath();
+
+  ctx.arc(
+    pillX + 48,
+    pillY + pillHeight / 2,
+    8,
+    0,
+    Math.PI * 2
+  );
+
+  ctx.fillStyle =
+    '#020503';
+
+  ctx.fill();
+
+
+  ctx.font =
+    '700 24px "Space Mono"';
+
+  ctx.fillStyle =
+    '#020503';
+
+  ctx.textAlign =
+    'center';
+
+  ctx.textBaseline =
+    'middle';
+
+
+  ctx.fillText(
+    ticketData.statusLabel,
+    W / 2 + 15,
+    pillY + pillHeight / 2
+  );
+
+
+  // =====================================================
+  // FOOTER
+  // =====================================================
+
+  ctx.textAlign =
+    'left';
+
+  ctx.font =
+    '700 16px "Space Mono"';
+
+  ctx.fillStyle =
+    'rgba(255,255,255,0.25)';
+
+
+  ctx.fillText(
+    'KICKOFF CHOUEIFAT',
+    70,
+    1810
+  );
+
+
+  ctx.textAlign =
+    'right';
+
+
+  ctx.fillText(
+    'OFFICIAL DIGITAL MATCH PASS',
+    W - 70,
+    1810
+  );
+
+
+  return canvas;
+}
+
