{
  "name": "kickoff-server",
  "version": "2.3.0",
  "description": "Responsive Kickoff layouts and clearer sign-in, preserving the original animations and security fixes",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:check": "node scripts/check-data.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "vendor:sync": "node scripts/vendor.js",
    "postinstall": "node scripts/vendor.js",
    "preview": "node server.js --preview",
    "audit:prod": "npm audit --omit=dev"
  },
  "keywords": [],
  "type": "commonjs",
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "chart.js": "4.6.1",
    "flatpickr": "4.6.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "jsdom": "^26.0.0"
  }
}
